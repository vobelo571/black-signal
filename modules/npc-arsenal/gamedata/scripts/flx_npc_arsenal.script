-- FLX NPC Arsenal: rank rules over the live system.ltx weapon catalogue.
-- Called by the bundled Weighted NPC Random Loadouts integration, not a second
-- spawn callback. There is exactly one weapon creation path per slot.
local catalogue, pools, affiliations, known_npc = {}, {}, {}, {}
local by_section = {}
local spawn_checks = {}
local settings, blacklist
local communities = {"stalker", "bandit", "renegade", "csky", "dolg", "army",
    "freedom", "killer", "ecolog", "monolith", "greh", "isg", "zombied"}
local ranks_list = {"novice", "trainee", "experienced", "professional",
    "veteran", "expert", "master", "legend"}
local rank_numbers = {novice=1, trainee=2, experienced=3, professional=4,
    veteran=5, expert=6, master=7, legend=8}
local rank_tiers = {novice=1, trainee=1, experienced=2, professional=2,
    veteran=3, expert=3, master=4, legend=4}
local kinds = {w_pistol="pistol", w_shotgun="shotgun", w_smg="smg",
    w_rifle="rifle", w_sniper="sniper", w_lmg="lmg", w_explosive="heavy",
    w_special="heavy"}
local firearm_classes = {WP_PM=true, WP_HPSA=true, WP_USP45=true, WP_LR300=true,
    WP_AK74=true, WP_GROZA=true, WP_VAL=true, WP_VINT=true, WP_SVD=true,
    WP_SVU=true, WP_SHOTG=true, WP_ASHTG=true, WP_BM16=true, WP_RG6=true,
    WP_RPG7=true, WP_GAUSS=true, WP_M134=true, WP_AK47=true}
-- Category weight is independent of the number of installed variants.
local styles = {
    stalker  = {rifle=42, shotgun=25, smg=13, sniper=13, lmg=7, pistol=8},
    bandit   = {rifle=32, shotgun=32, smg=24, sniper=8, lmg=4, pistol=12},
    renegade = {rifle=36, shotgun=30, smg=22, sniper=8, lmg=4, pistol=12},
    csky     = {rifle=45, shotgun=23, smg=14, sniper=12, lmg=6, pistol=8},
    dolg     = {rifle=53, shotgun=17, smg=5, sniper=10, lmg=15, heavy=0.3},
    army     = {rifle=62, shotgun=5, smg=3, sniper=15, lmg=15, heavy=0.6},
    freedom  = {rifle=58, shotgun=10, smg=12, sniper=14, lmg=6},
    killer   = {rifle=52, shotgun=12, smg=13, sniper=16, lmg=7},
    ecolog   = {rifle=36, shotgun=25, smg=24, sniper=12, lmg=3, pistol=8},
    monolith = {rifle=50, shotgun=13, smg=5, sniper=17, lmg=15, heavy=0.9},
    greh     = {rifle=43, shotgun=26, smg=8, sniper=13, lmg=10, heavy=0.3},
    isg      = {rifle=57, shotgun=9, smg=9, sniper=15, lmg=10, heavy=0.4},
    zombied  = {rifle=40, shotgun=27, smg=17, sniper=10, lmg=6, pistol=10},
}
local eastern = {army=true, dolg=true, greh=true, bandit=true, renegade=true}
local western = {freedom=true, killer=true, isg=true}
local aliases = {army_npc="army", military="army", greh_npc="greh",
    mercenary="killer", duty="dolg", loner="stalker", monolit="monolith"}

local function read(ini, sec, key)
    return ini and ini:section_exist(sec) and ini:r_string_ex(sec, key) or nil
end

function can_spawn(section)
    local cached = spawn_checks[section]
    if cached then return cached.ok, cached.reason end
    local blocked = read(settings, "unsafe_variants", section)
    if blocked then
        local reason = "reviewed unsafe variant: " .. blocked
        spawn_checks[section] = {ok=false, reason=reason}
        return false, reason
    end
    local config_ok, config_reason = flx_npc_arsenal_config.validate(ini_sys, section)
    if not config_ok then
        spawn_checks[section] = {ok=false, reason=config_reason}
        return false, config_reason
    end
    local hud = read(ini_sys, section, "hud")
    local visual = read(ini_sys, section, "visual")
    local item_visual = hud and read(ini_sys, hud, "item_visual")
    local reason
    -- CWeapon::Load reads all three fields unconditionally. Validate the final
    -- scope/kit section as well as catalogue bases before any item is created.
    for _, key in ipairs({"scope_status", "silencer_status", "grenade_launcher_status"}) do
        local status = tonumber(read(ini_sys, section, key))
        if status ~= 0 and status ~= 1 and status ~= 2 then
            reason = "missing or invalid " .. key .. " in " .. section
            spawn_checks[section] = {ok=false, reason=reason}
            return false, reason
        end
    end
    if not hud then reason = "missing hud reference"
    elseif not ini_sys:section_exist(hud) then reason = "missing HUD section " .. hud
    elseif not item_visual or item_visual == "" then reason = "missing item_visual in " .. hud
    elseif not read(ini_sys, hud, "attach_place_idx") then reason = "missing attach_place_idx in " .. hud
    elseif not read(ini_sys, hud, "item_position") then reason = "missing item_position in " .. hud
    elseif not read(ini_sys, hud, "item_orientation") then reason = "missing item_orientation in " .. hud
    elseif not read(ini_sys, hud, "hands_position") or not read(ini_sys, hud, "hands_orientation") or
        not read(ini_sys, hud, "hands_position_16x9") or not read(ini_sys, hud, "hands_orientation_16x9") then
        reason = "missing required hand transforms in " .. hud
    elseif not visual or visual == "" then reason = "missing world visual"
    elseif getFS then
        local fs = getFS()
        local function model_exists(path)
            if string.lower(string.sub(path, -4)) ~= ".ogf" then path = path .. ".ogf" end
            local found = fs:exist("$game_meshes$", path)
            return found ~= nil and found ~= false
        end
        if not model_exists(item_visual) then reason = "missing HUD model " .. item_visual
        elseif not model_exists(visual) then reason = "missing world model " .. visual end
    end
    local ok = reason == nil
    spawn_checks[section] = {ok=ok, reason=reason}
    return ok, reason
end

local function number(ini, sec, key, default)
    return tonumber(read(ini, sec, key)) or default
end

local function contains(s, part)
    return s and string.find(s, part, 1, true) ~= nil
end

local function tokens(s)
    local result = {}
    for item in string.gmatch(s or "", "[^,%s]+") do
        result[#result+1] = item
    end
    return result
end

local function canonical(section)
    local parent = read(ini_sys, section, "parent_section")
    return parent and ini_sys:section_exist(parent) and parent or section
end

local function origin(sec, ammo)
    if contains(ammo, "5.45x39") or contains(ammo, "7.62x39") or
        contains(ammo, "7.62x54") or contains(ammo, "9x39") or
        contains(ammo, "9x18") or contains(ammo, "7.62x25") or
        contains(ammo, "12.7x55") or contains(ammo, "23x75") then
        return "east"
    end
    if contains(ammo, "5.56x45") or contains(ammo, "7.62x51") or
        contains(ammo, "11.43x23") or contains(ammo, "5.7x28") or
        contains(ammo, "4.6x30") or contains(ammo, "338") then
        return "west"
    end
    if contains(sec, "ak") or contains(sec, "sr2") or contains(sec, "pp") or
        contains(sec, "toz") or contains(sec, "saiga") or contains(sec, "vepr") then
        return "east"
    end
    return "neutral"
end

local function family(sec)
    -- Group prolific attachments/kits so installing 30 AK variants does not
    -- make every NPC use an AK. Every distinct model still has a positive chance.
    local s = string.gsub(sec, "^wpn_", "")
    local f = string.match(s, "^([^_]+)") or s
    if string.match(f, "^ak%d") or f == "akm" or f == "akms" then return "ak" end
    if string.match(f, "^g36") then return "g36" end
    if string.match(f, "^m4") or f == "xm4" or f == "ar15" then return "ar15" end
    if string.match(f, "^glock") then return "glock" end
    if string.match(f, "^rpk") then return "rpk" end
    if string.match(f, "^svd") then return "svd" end
    return f
end

function meets_rank_requirement(section, rank)
    local base = canonical(section)
    local entry = by_section[base] or classify(base)
    return entry and (rank_numbers[rank] or 3) >= entry.minimum_rank or false
end

function classify(section)
    local kind = read(ini_sys, section, "kind")
    local cls = read(ini_sys, section, "class")
    local category = kinds[kind]
    if not category or not firearm_classes[cls] then return nil end
    if contains(section, "_hud") or contains(section, "_fake") or
        contains(section, "_debug") or contains(section, "_quest") or
        contains(section, "_unstrapped") then return nil end
    local npc = read(ini_sys, section, "$npc")
    -- Some working GAMMA weapons (9A-91, Vikhr) carry $npc=off but are
    -- explicitly used in the shipped NPC loadouts. Keep that proven support.
    if not known_npc[section] and (npc == "off" or npc == "false" or npc == "0") then return nil end
    if read(settings, "exclude", section) then return nil end
    if not known_npc[section] and read(blacklist, "ignore_sections", section) then return nil end
    local ammo = read(ini_sys, section, "ammo_class")
    local ammo_index
    for i, a in ipairs(tokens(ammo)) do
        if ini_sys:section_exist(a) then ammo_index = i - 1; break end
    end
    local cost = number(ini_sys, section, "cost", 0)
    if ammo_index == nil or cost <= 0 or not read(ini_sys, section, "visual") or
        not read(ini_sys, section, "hud") or
        number(ini_sys, section, "inv_grid_width", 0) < 1 then return nil end
    local mag = number(ini_sys, section, "ammo_mag_size", 0)
    if mag < 1 then return nil end
    -- Scoped sections are spawned by the original attachment resolver.
    -- Retain named kits with their own parent_section as independent weapons.
    if canonical(section) ~= section then return nil end
    local spawn_ok, spawn_reason = can_spawn(section)
    if not spawn_ok then
        printe("! [FLX NPC Arsenal] unsafe weapon skipped: %s | %s", section, spawn_reason)
        return nil
    end

    -- Anomaly labels most machine guns as w_rifle, and some packs even use
    -- pistol engine classes for them. Prefer the actual weapon family/calibre.
    if category == "rifle" and (contains(section, "wpn_rpk") or
        contains(section, "wpn_pkm") or contains(section, "wpn_pkp") or
        contains(section, "wpn_hk21") or contains(section, "wpn_m249") or
        contains(section, "wpn_m60") or contains(section, "wpn_mg42") or
        contains(section, "wpn_mg3") or contains(section, "wpn_rpd") or
        (mag >= 75 and contains(read(ini_sys, section, "fire_modes"), "-1"))) then
        category = "lmg"
    end
    if contains(ammo, "ammo_gauss") then category = "heavy" end

    local tier
    local old = contains(section, "mosin") or contains(section, "sks") or
        contains(section, "svt40") or contains(section, "winchester18") or
        contains(section, "kar98") or contains(section, "wpn_k98") or
        contains(section, "wpn_g43") or contains(section, "springfield")
    local double = category == "shotgun" and (mag <= 2 or cls == "WP_BM16" or
        contains(section, "toz34") or contains(section, "bm16"))
    if category == "pistol" then
        tier = cost < 10000 and 1 or cost < 22000 and 2 or cost < 40000 and 3 or 4
    elseif double then
        tier = 1
    elseif old then
        tier = cost < 40000 and 1 or 2
    elseif category == "shotgun" then
        tier = cost < 20000 and 1 or cost < 35000 and 2 or cost < 65000 and 3 or 4
    elseif category == "smg" then
        tier = cost < 25000 and 1 or cost < 45000 and 2 or 3
    elseif category == "heavy" or cls == "WP_GAUSS" then
        category, tier = "heavy", 4
    elseif category == "lmg" then
        tier = cost < 65000 and 3 or 4
    else
        tier = cost < 20000 and 1 or cost < 40000 and 2 or cost < 80000 and 3 or 4
    end
    -- Common service weapons are viable throughout a career, while the truly
    -- primitive guns above stay in the low tiers even with a high modded price.
    if category == "rifle" and not old and cost >= 25000 then tier = math.max(3, tier) end
    local group = read(settings, "family_overrides", section) or family(section)
    local role = tier <= 2 and "service" or "specialist"
    local minimum = tier == 4 and 7 or tier == 3 and 5 or tier == 2 and 3 or 1
    if tier == 1 then role = "budget" end
    if category == "pistol" and tier == 2 then minimum = 2 end
    -- Metadata fallback for newly installed or runtime-only addon sections.
    -- Service arms can equip ordinary troops, special systems cannot.
    local tactical = contains(section, "_isg") or contains(section, "_alfa") or
        contains(section, "_pmc") or contains(section, "_admin") or contains(section, "_tac")
    local service = group == "ak" or group == "ar15" or group == "g36" or
        group == "aug" or group == "sig550" or group == "fal" or group == "l85"
    if category == "rifle" and service and not tactical and cost < 60000 and not old then
        tier, minimum, role = 3, 3, "service"
    end
    if category == "smg" and (contains(ammo, "5.56x45") or contains(ammo, "5.45x39")) then
        category, tier, minimum, role = "rifle", 3, 5, "specialist"
    end
    if category == "rifle" and contains(ammo, "9x39") then tier, minimum, role = 3, 5, "specialist" end
    if category == "rifle" and contains(ammo, "12.7x55") then tier, minimum, role = 4, 7, "elite" end
    if category == "sniper" and not old then
        tier, minimum, role = math.max(3, tier), math.max(5, minimum), "specialist"
    end
    if category == "sniper" and (contains(ammo, "12.7x") or contains(ammo, "338")) then
        tier, minimum, role = 4, 7, "elite"
    end
    if category == "shotgun" and contains(ammo, "23x75") then
        tier, minimum, role = double and 2 or 3, double and 4 or 5, "specialist"
    end
    if category == "shotgun" and mag >= 12 and contains(read(ini_sys, section, "fire_modes"), "-1") then
        tier, minimum, role = 4, 7, "elite"
    end
    if category == "lmg" and contains(ammo, "ammo_pkm") then minimum = math.max(minimum, 6) end
    if category == "smg" and (contains(ammo, "5.7x28") or contains(ammo, "4.6x30") or
        group == "sr2" or group == "mp9") then tier, minimum, role = 3, 5, "specialist" end
    if tactical then minimum = math.max(minimum, contains(section, "_isg") and 7 or 5) end
    if contains(section, "_isg") then tier, role = 4, "elite" end
    local reviewed = tokens(read(settings, "weapon_rules", section))
    if reviewed[1] then
        tier, minimum, role = tonumber(reviewed[1]) or tier, tonumber(reviewed[2]) or minimum, reviewed[3] or role
    end
    tier = math.max(1, math.min(4, number(settings, "tier_overrides", section, tier)))
    minimum = number(settings, "minimum_rank_by_family", group, minimum)
    minimum = number(settings, "minimum_rank_overrides", section, minimum)
    minimum = math.max(1, math.min(8, minimum))
    if tier == 4 then minimum, role = math.max(7, minimum), "elite" end
    return {sec=section, category=category, tier=tier, cost=cost,
        spawn_section=read(settings, "spawn_aliases", section) or section,
        origin=read(settings, "origin_overrides", section) or origin(section, ammo),
        family=group, minimum_rank=minimum, role=role, rule_source=reviewed[1] and "reviewed" or "automatic",
        primitive=old or double, double=double, ammo_index=ammo_index}
end

local function learn_affiliations(ini)
    ini:section_for_each(function(section)
        for i=0,ini:line_count(section)-1 do
            local _, entry = ini:r_line_ex(section, i, "", "")
            local weapon = string.match(entry or "", "^(wpn_[^:]+)")
            if weapon and ini_sys:section_exist(weapon) then
                known_npc[canonical(weapon)] = true
            end
        end
    end)
    for _, comm in ipairs(communities) do
        affiliations[comm] = {}
        for _, rank in ipairs(ranks_list) do
            local loadout = comm .. "_" .. rank
            for _, slot_type in ipairs({"primary", "secondary"}) do
                local slot = read(ini, loadout, slot_type)
                if slot and ini:section_exist(slot) then
                    for i=0,ini:line_count(slot)-1 do
                        local _, entry = ini:r_line_ex(slot, i, "", "")
                        local section = string.match(entry or "", "^[^:]+")
                        if section and ini_sys:section_exist(section) then
                            affiliations[comm][canonical(section)] = true
                            known_npc[canonical(section)] = true
                        end
                    end
                end
            end
        end
    end
end

function initialize(ini)
    catalogue, pools, affiliations, known_npc = {}, {}, {}, {}
    by_section = {}
    spawn_checks = {}
    settings = ini_file("plugins\\flx_npc_arsenal.ltx")
    blacklist = ini_file("plugins\\spawner_blacklist.ltx")
    learn_affiliations(ini)
    ini_sys:section_for_each(function(section)
        local entry = classify(section)
        if entry then catalogue[#catalogue+1] = entry; by_section[section] = entry end
    end)
    table.sort(catalogue, function(a,b) return a.sec < b.sec end)
    printf("[FLX NPC Arsenal] v1.3.0: %s base weapons/kits from live system.ltx", #catalogue)
    audit_catalogue()
end

-- Kept for callers using the old API. Visuals no longer affect loadouts.
function armour_level(visual) return 1 end

function is_generic(section, profile)
    return string.match(section or "", "^sim_default_[%w_]+_%d+$") ~= nil and
        (string.match(profile or section or "", "^sim_default_[%w_]+_%d+$") ~= nil or
         string.match(profile or "", "^dick_sim_default_[%w_]+_%d+$") ~= nil)
end

local function limits(rank, slot_type)
    local level = rank_tiers[rank] or 2
    local low = level == 4 and 3 or level == 3 and 2 or 1
    local high = level == 1 and 2 or level == 2 and 3 or 4
    if slot_type == "secondary" then low = level >= 3 and 2 or 1 end
    return low, high, level
end

function eligible(entry, comm, rank, armour, slot_type)
    if (rank_numbers[rank] or 3) < entry.minimum_rank then return false end
    local low, high, level = limits(rank, slot_type)
    if entry.tier < low or entry.tier > high then return false end
    if slot_type == "secondary" then return entry.category == "pistol" end
    if entry.category == "pistol" then return level == 1 end
    if entry.primitive and level >= 3 then return false end
    return true
end

function weapon_allowed(section, comm, rank, visual, slot_type)
    if not can_spawn(section) then return false end
    local base = canonical(section)
    local entry = by_section[base] or classify(base)
    return entry and eligible(entry, comm, rank, 1, slot_type) or false
end

function audit_catalogue()
    local unreachable, empty = 0, 0
    local reviewed, automatic = 0, 0
    local dump = read(settings, "audit", "log_catalogue") == "true"
    for _, weapon in ipairs(catalogue) do
        if weapon.rule_source == "reviewed" then reviewed = reviewed + 1 else automatic = automatic + 1 end
        local reached = false
        for _, rank in ipairs(ranks_list) do
            for _, comm in ipairs(communities) do
                local slot = weapon.category == "pistol" and "secondary" or "primary"
                if eligible(weapon, comm, rank, 1, slot) then reached = true; break end
            end
            if reached then break end
        end
        if not reached then unreachable = unreachable + 1; printe("! [FLX NPC Arsenal] unreachable weapon: %s", weapon.sec) end
        if dump then
            printf("[FLX NPC Arsenal RULE] %s | quality=%s | min_rank=%s | %s | %s | %s",
                weapon.sec, weapon.tier, weapon.minimum_rank, weapon.category, weapon.role, weapon.rule_source)
        end
    end
    for _, comm in ipairs(communities) do
        for _, rank in ipairs(ranks_list) do
            for _, slot in ipairs({"primary", "secondary"}) do
                local found = false
                for _, weapon in ipairs(catalogue) do
                    if eligible(weapon, comm, rank, 1, slot) then found = true; break end
                end
                if not found then
                    empty = empty + 1
                    printe("! [FLX NPC Arsenal] empty rank pool: %s %s %s", comm, rank, slot)
                end
            end
        end
    end
    printf("[FLX NPC Arsenal] live audit: weapons=%s unreachable=%s empty_pools=%s reviewed=%s automatic=%s",
        #catalogue, unreachable, empty, reviewed, automatic)
    return unreachable, empty
end

local function weighted(items)
    local sum = 0
    for _, item in ipairs(items) do sum = sum + item.weight end
    if sum <= 0 then return nil end
    local roll = math.random() * sum
    for _, item in ipairs(items) do
        roll = roll - item.weight
        if roll < 0 then return item end
    end
    return items[#items]
end

local function build_pool(comm, rank, slot_type)
    local style = styles[comm] or styles.stalker
    local categories, groups = {}, {}
    local _, _, level = limits(rank, slot_type)
    for _, weapon in ipairs(catalogue) do
        if eligible(weapon, comm, rank, 1, slot_type) then
            local cat = weapon.category
            if not groups[cat] then groups[cat] = {} end
            local fam = weapon.family
            local group = groups[cat][fam]
            if not group then
                group = {weight=1, items={}, affinity=0}
                groups[cat][fam] = group
            end
            local native = affiliations[comm] and affiliations[comm][weapon.sec]
            local affinity = native and 2.5 or 1
            if eastern[comm] then
                affinity = affinity * (weapon.origin == "east" and 2.5 or weapon.origin == "west" and 0.4 or 1)
            elseif western[comm] then
                affinity = affinity * (weapon.origin == "west" and 2.5 or weapon.origin == "east" and 0.4 or 1)
            end
            -- Prefer equipment near the NPC's grade, with rare outliers inside
            -- the hard bounds. Legends more often carry tier four equipment.
            local target = rank == "legend" and 4 or level
            local quality = weapon.tier == target and 2 or 1
            local weight = affinity * quality
            group.items[#group.items+1] = {weight=weight, weapon=weapon}
            group.affinity = group.affinity + weight
        end
    end
    -- Sort every bucket for deterministic seeded tests, regardless of Lua hash order.
    for _, cat in ipairs({"pistol", "smg", "shotgun", "rifle", "sniper", "lmg", "heavy"}) do
        if groups[cat] then
            local names, families = {}, {}
            for fam in pairs(groups[cat]) do names[#names+1] = fam end
            table.sort(names)
            for _, fam in ipairs(names) do
                local group = groups[cat][fam]
                group.weight = group.affinity / #group.items
                families[#families+1] = group
            end
            local weight = slot_type == "secondary" and 1 or (style[cat] or 1)
            if cat == "pistol" and slot_type == "primary" then weight = style.pistol or 3 end
            categories[#categories+1] = {weight=weight, items=families}
        end
    end
    return categories
end

function pick(comm, rank, visual, slot_type)
    if slot_type == "extra" then return nil end
    comm = aliases[comm] or comm
    local key = comm .. ":" .. (rank or "") .. ":" .. slot_type
    if not pools[key] then pools[key] = build_pool(comm, rank, slot_type) end
    local category = weighted(pools[key])
    local group = category and weighted(category.items)
    local choice = group and weighted(group.items)
    if not choice then return nil end
    return {sec=choice.weapon.spawn_section, attachment="r", ammo_type=tostring(choice.weapon.ammo_index),
        scope_chance="d", gl_chance="d", sil_chance="d"}
end

-- Read-only diagnostics, callable from the game's script console / audit harness.
function get_catalogue() return catalogue end
function print_catalogue()
    for _, w in ipairs(catalogue) do
        printf("[FLX NPC Arsenal] %s | %s | tier=%s | %s | family=%s",
            w.sec, w.category, w.tier, w.origin, w.family)
    end
end
