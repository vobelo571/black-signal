-- FLX NPC Arsenal 1.1.1: one-time, save-persistent rearm of ordinary online NPCs.
-- Uses the existing creator/attachment path. Old guns are retained until all
-- replacement guns are observed in the owner's live inventory on a later tick.
local KEY = "flx_npc_arsenal_migration_1" -- also written by the new-NPC spawn path
local RULE_REVISION = 2
local ini, loadouts
local ready_at, next_batch = math.huge, 0
local checks, protected_ids, task_frame = {}, {}, -1

local function read(sec, key)
    return ini and ini:section_exist(sec) and ini:r_string_ex(sec, key)
end

local function option(key, default)
    return tonumber(read("migration", key)) or default
end

local function firearm_slot(section)
    local kind = ini_sys:r_string_ex(section, "kind")
    if kind == "w_pistol" then return "secondary" end
    if kind == "w_rifle" or kind == "w_sniper" or kind == "w_smg" or
        kind == "w_shotgun" or kind == "w_lmg" or kind == "w_explosive" or
        kind == "w_special" then return "primary" end
end

local function story(id)
    local value = id and get_object_story_id(id)
    return value ~= nil and value ~= false and value ~= -1
end

local function add_id(value)
    local id = tonumber(value)
    if id and id > 0 and id < 65535 then protected_ids[id] = true end
end

local function tasks_ready()
    local manager = task_manager and task_manager.get_task_manager()
    if not manager or not manager.task_info then return false end
    local now = time_global()
    if task_frame == now then return true end
    task_frame, protected_ids = now, {}
    for _, task in pairs(manager.task_info) do
        if task.status ~= "completed" and task.status ~= "fail" then
            add_id(task.task_giver_id)
            add_id(task.current_target)
        end
    end
    if axr_task_manager then
        for _, registry in pairs({axr_task_manager.bounties_by_id or {}, axr_task_manager.hostages_by_id or {}}) do
            -- Anomaly uses both task_id->npc and npc->smart tables here.
            for key, value in pairs(registry) do add_id(key); add_id(value) end
        end
    end
    return true
end

local function squad_protected(squad)
    if story(squad.id) or protected_ids[squad.id] then return true end
    if sim_offline_combat and sim_offline_combat.task_squads and
        sim_offline_combat.task_squads[squad.id] then return true end
    if axr_companions and axr_companions.companion_squads and
        axr_companions.companion_squads[squad.id] then return true end
    if squad.scripted_target and squad.scripted_target ~= "" then return true end
    if squad.squad_members then
        for member in squad:squad_members() do
            if story(member.id) or protected_ids[member.id] then return true end
        end
    end
    return false
end

function protected_reason(npc, se_npc)
    if not npc or not se_npc or not IsStalker(npc) or not npc:alive() then return "not_living_stalker" end
    local id, sec = npc:id(), se_npc:section_name()
    -- Explicit whitelist: do not infer that a named profile is generic merely
    -- because it lacks a story_id (many addon quest characters have no story_id).
    if not string.match(sec or "", "^sim_default_[%w_]+_%d+$") then return "named_section" end
    local profile = npc:profile_name() or ""
    if not string.match(profile, "^sim_default_[%w_]+_%d+$") and
        not string.match(profile, "^dick_sim_default_[%w_]+_%d+$") then return "named_profile" end
    if story(id) then return "story_npc" end
    if read("migration_exclude", sec) then return "manual_exclusion" end
    if loadouts:r_string_ex("skip_npcs", sec) or loadouts:r_string_ex("loadouts_per_name", sec) then return "special_loadout" end
    if not tasks_ready() then return "tasks_not_ready" end
    if protected_ids[id] then return "active_quest" end
    if axr_companions and axr_companions.non_task_companions and
        axr_companions.non_task_companions[id] then return "companion" end
    local squad = se_npc.group_id and se_npc.group_id < 65535 and alife_object(se_npc.group_id)
    if squad then
        if squad_protected(squad) then return "protected_squad" end
        if loadouts:r_string_ex("loadouts_per_squad", squad:section_name()) then return "special_squad" end
    end
    if utils_item.has_quest_item(npc) then return "quest_inventory" end
    local protected_item = false
    npc:iterate_inventory(function(owner, item)
        if story(item:id()) or se_load_var(item:id(), npc:name(), "strapped_item") then
            protected_item = true
        end
    end)
    if protected_item then return "story_or_player_item" end
end

local function busy(npc)
    return npc:best_enemy() ~= nil or npc:is_talking() or xr_wounded.is_wounded(npc)
end

local function descriptor(item)
    return {id=item:id(), sec=item:section(), name=item:name()}
end

local function owned(desc, id)
    local obj = alife_object(desc.id)
    if obj and obj.parent_id == id and obj:section_name() == desc.sec and obj:name() == desc.name then
        return obj
    end
end

local function rollback(npc, transaction)
    for _, desc in ipairs(transaction.new) do
        local item = owned(desc, npc:id())
        if item then alife_release(item) end
    end
    se_save_var(npc:id(), npc:name(), KEY, nil)
end

local function begin_rearm(npc, se_npc)
    local comm = npc:character_community()
    local rank = ranks.get_obj_rank_name(se_npc)
    local visual = npc:get_visual_name() -- includes live FLX armour replacements
    local old, conditions, has_sidearm = {}, {}, false
    npc:iterate_inventory(function(owner, item)
        local slot = firearm_slot(item:section())
        if slot then
            old[#old+1] = descriptor(item)
            conditions[slot] = math.max(conditions[slot] or 0, item:condition())
            if slot == "secondary" then has_sidearm = true end
        end
    end)
    local transaction = {name=npc:name(), old=old, new={}}
    local squad = se_npc.group_id and se_npc.group_id < 65535 and alife_object(se_npc.group_id)
    local squad_name = squad and squad:section_name() or "na"
    local slots = has_sidearm and {"primary", "secondary"} or {"primary"}
    for _, slot in ipairs(slots) do
        local entry = flx_npc_arsenal.pick(comm, rank, visual, slot)
        local weapon = entry and xrs_rnd_npc_loadout.create_item_on_npc(
            se_npc, squad_name, comm, rank, visual, nil, slot, entry)
        if not weapon then
            rollback(npc, transaction)
            return "spawn_failed"
        end
        transaction.new[#transaction.new+1] = {id=weapon.id, sec=weapon:section_name(),
            name=weapon:name(), condition=conditions[slot] or 0.75}
    end
    -- Server data survives saving, offline transitions and reloads mid-transaction.
    se_save_var(npc:id(), npc:name(), KEY, transaction)
    return "pending"
end

local function finish_rearm(npc, transaction)
    local inventory = {}
    npc:iterate_inventory(function(owner, item) inventory[item:id()] = item end)
    for _, desc in ipairs(transaction.new) do
        if not owned(desc, npc:id()) then
            rollback(npc, transaction)
            return "replacement_lost"
        end
        if not inventory[desc.id] then
            transaction.waits = (transaction.waits or 0) + 1
            if transaction.waits >= 50 then
                rollback(npc, transaction)
                return "attachment_timeout"
            end
            se_save_var(npc:id(), npc:name(), KEY, transaction)
            return "pending"
        end
    end
    -- All new weapons are attached and visible online. Preserve the previous
    -- condition, so migration does not turn damaged NPC equipment into free mint loot.
    for _, desc in ipairs(transaction.new) do inventory[desc.id]:set_condition(desc.condition) end
    for _, desc in ipairs(transaction.old) do
        local weapon = owned(desc, npc:id())
        if weapon then alife_release(weapon) end
    end
    se_save_var(npc:id(), npc:name(), KEY, {name=npc:name(), done=true, rule_revision=RULE_REVISION})
    printf("[FLX NPC Arsenal] migrated existing NPC %s (%s)", npc:name(), npc:id())
    return "done"
end

function process_npc(npc, se_npc)
    if not npc or not se_npc then return "missing" end
    local state = se_load_var(npc:id(), npc:name(), KEY)
    if state and state.name == npc:name() and state.done and state.rule_revision == RULE_REVISION then return "already_done" end
    local pending = state and state.name == npc:name() and state.new and state
    local reason = protected_reason(npc, se_npc)
    if reason then
        if pending then rollback(npc, pending) end
        return reason
    end
    if state and state.name == npc:name() and state.done then
        local rank = ranks.get_obj_rank_name(se_npc)
        local needs_update = false
        npc:iterate_inventory(function(owner, item)
            if firearm_slot(item:section()) and not flx_npc_arsenal.meets_rank_requirement(item:section(), rank) then
                needs_update = true
            end
        end)
        if not needs_update then
            se_save_var(npc:id(), npc:name(), KEY, {name=npc:name(), done=true, rule_revision=RULE_REVISION})
            return "already_done"
        end
    end
    if busy(npc) then return "busy" end
    if pending then return finish_rearm(npc, pending) end
    return begin_rearm(npc, se_npc)
end

function actor_on_first_update()
    ready_at = time_global() + option("startup_delay_ms", 3000)
    next_batch, checks, protected_ids, task_frame = 0, {}, {}, -1
end

function npc_on_death(npc)
    local state = npc and se_load_var(npc:id(), npc:name(), KEY)
    if state and state.name == npc:name() and state.new and not state.done then rollback(npc, state) end
end

function npc_on_update(npc)
    local now = time_global()
    if now < ready_at or now < next_batch or not npc or not IsStalker(npc) or not npc:alive() then return end
    local id, name = npc:id(), npc:name()
    local check = checks[id]
    if check and check.name == name and now < check.next then return end
    local state = se_load_var(id, name, KEY)
    if state and state.name == name and state.done and state.rule_revision == RULE_REVISION then
        checks[id] = {name=name, next=math.huge}
        return
    end
    local se_npc = alife_object(id)
    if not se_npc then return end
    local result = process_npc(npc, se_npc)
    local pending = result == "pending"
    checks[id] = {name=name, next=now + (pending and 300 or option("retry_interval_ms", 10000))}
    next_batch = now + option("batch_interval_ms", 200)
end

function on_game_start()
    ini = ini_file("plugins\\flx_npc_arsenal.ltx")
    loadouts = ini_file("items\\settings\\npc_loadouts\\npc_loadouts.ltx")
    local enabled = read("migration", "enable")
    if enabled == "false" or enabled == "0" then return end
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("npc_on_update", npc_on_update)
    RegisterScriptCallback("npc_on_death_callback", npc_on_death)
end
