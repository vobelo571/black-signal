-- FLX NPC Arsenal 1.3.0: selective, save-persistent rearm of ordinary online NPCs.
-- Uses the existing creator/attachment path. Old guns are retained until all
-- replacement guns are observed in the owner's live inventory on a later tick.
local KEY = "flx_npc_arsenal_migration_1" -- also written by the new-NPC spawn path
local RULE_REVISION = 7
local ini
local ready_at, next_batch = math.huge, 0
local checks = {}

local function read(sec, key)
    return ini and ini:section_exist(sec) and ini:r_string_ex(sec, key)
end

local function option(key, default)
    return tonumber(read("migration", key)) or default
end

local function firearm_slot(section)
    local kind = ini_sys:r_string_ex(section, "kind")
    if kind == "w_pistol" then return "secondary" end
    if kind == "w_rifle" or kind == "w_sniper" or kind == "w_smg" or
        kind == "w_shotgun" or kind == "w_lmg" or kind == "w_explosive" or
        kind == "w_special" then return "primary" end
end

local function story(id)
    local value = id and get_object_story_id(id)
    return value ~= nil and value ~= false and value ~= -1
end

function protected_reason(npc, se_npc)
    if not npc or not se_npc or not IsStalker(npc) or not npc:alive() then return "not_living_stalker" end
    local id, section = npc:id(), se_npc:section_name()
    if not flx_npc_arsenal.is_generic(section, npc:profile_name()) then return "unique_npc" end
    if story(id) then return "story_npc" end
    if read("migration_exclude", section) then return "manual_exclusion" end
    -- Only this NPC's actual quest role matters. An ordinary squadmate or
    -- random bounty target is still an ordinary NPC and follows the rank rule.
    local bounties = axr_task_manager and axr_task_manager.bounties_by_id or {}
    local hostages = axr_task_manager and axr_task_manager.hostages_by_id or {}
    if hostages[id] then return "hostage" end
    local manager = task_manager and task_manager.get_task_manager()
    for task_id, task in pairs(manager and manager.task_info or {}) do
        if task.status ~= "completed" and task.status ~= "fail" then
            if tonumber(task.task_giver_id) == id then return "quest_giver" end
            if tonumber(task.current_target) == id and tonumber(bounties[task_id]) ~= id then
                return "quest_target"
            end
        end
    end
    if utils_item.has_quest_item(npc) then return "quest_inventory" end
    local quest_item = false
    npc:iterate_inventory(function(owner, item)
        if story(item:id()) then quest_item = true end
    end)
    if quest_item then return "story_item" end
end

local function busy(npc, pending)
    if npc:is_talking() or xr_wounded.is_wounded(npc) then return true end
    if npc:best_enemy() == nil then return false end
    -- A combatant with no gun cannot wait for combat to end to be restored.
    -- Permit an additive transaction only; never swap/remove existing guns here.
    if pending and pending.old and #pending.old == 0 then return false end
    local armed = false
    npc:iterate_inventory(function(owner,item)
        if firearm_slot(item:section()) then armed = true end
    end)
    return armed
end

local function descriptor(item)
    return {id=item:id(), sec=item:section(), name=item:name()}
end

local function owned(desc, id)
    local obj = alife_object(desc.id)
    if obj and obj.parent_id == id and obj:section_name() == desc.sec and obj:name() == desc.name then
        return obj
    end
end

local function rollback_by_id(id, name, transaction)
    for _, desc in ipairs(transaction.new) do
        local item = owned(desc, id)
        if item then alife_release(item) end
    end
    se_save_var(id, name, KEY, nil)
end

local function rollback(npc, transaction)
    rollback_by_id(npc:id(), npc:name(), transaction)
end

local function finish_dead_cleanup(id, name)
    local owner = alife_object(id)
    if not owner or owner:name() ~= name then return true end
    local state = se_load_var(id, name, KEY)
    if not (state and state.name == name and state.new and not state.done and state.cleanup_after_death) then
        return true
    end
    rollback_by_id(id, name, state)
    printf("[FLX NPC Arsenal] deferred death cleanup complete | npc=%s:%s", name, id)
    return true
end

local function queue_dead_cleanup(npc)
    local id, name = npc:id(), npc:name()
    local state = se_load_var(id, name, KEY)
    if not (state and state.name == name and state.new and not state.done) then return end
    state.cleanup_after_death = true
    se_save_var(id, name, KEY, state)
    -- Native death processing still owns the inventory. Do not release its
    -- children here, and never keep a game_object in a delayed callback.
    CreateTimeEvent("flx_npc_arsenal_dead_cleanup", id, 0.1, finish_dead_cleanup, id, name)
    printf("[FLX NPC Arsenal] deferred death cleanup queued | npc=%s:%s", name, id)
end

local function begin_rearm(npc, se_npc)
    local comm = npc:character_community()
    local rank = ranks.get_obj_rank_name(se_npc)
    local visual = npc:get_visual_name() -- includes live FLX armour replacements
    local old, conditions = {}, {}
    local counts, valid = {primary=0, secondary=0}, {primary=0, secondary=0}
    local pistol_primary = false
    npc:iterate_inventory(function(owner, item)
        local slot = firearm_slot(item:section())
        if slot then
            counts[slot] = counts[slot] + 1
            if flx_npc_arsenal.weapon_allowed(item:section(), comm, rank, visual, slot) then
                valid[slot] = valid[slot] + 1
                if slot == "secondary" and flx_npc_arsenal.weapon_allowed(item:section(), comm, rank, visual, "primary") then
                    pistol_primary = true
                end
            else
                old[#old+1] = descriptor(item)
                conditions[slot] = math.max(conditions[slot] or 0, item:condition())
            end
        end
    end)
    local slots = {}
    if valid.primary == 0 and not pistol_primary then slots[#slots+1] = "primary" end
    if counts.secondary > 0 and valid.secondary == 0 then slots[#slots+1] = "secondary" end
    if #old == 0 and #slots == 0 then
        se_save_var(npc:id(), npc:name(), KEY, {name=npc:name(), done=true, rule_revision=RULE_REVISION})
        return "already_done"
    end
    local transaction = {name=npc:name(), old=old, new={}}
    local squad = se_npc.group_id and se_npc.group_id < 65535 and alife_object(se_npc.group_id)
    local squad_name = squad and squad:section_name() or "na"
    for _, slot in ipairs(slots) do
        local entry = flx_npc_arsenal.pick(comm, rank, visual, slot)
        local weapon = entry and xrs_rnd_npc_loadout.create_item_on_npc(
            se_npc, squad_name, comm, rank, visual, nil, slot, entry)
        if not weapon then
            rollback(npc, transaction)
            return "spawn_failed"
        end
        transaction.new[#transaction.new+1] = {id=weapon.id, sec=weapon:section_name(),
            name=weapon:name(), slot=slot, condition=conditions[slot] or 0.75}
    end
    -- Server data survives saving, offline transitions and reloads mid-transaction.
    se_save_var(npc:id(), npc:name(), KEY, transaction)
    return "pending"
end

local function finish_rearm(npc, transaction)
    local inventory = {}
    npc:iterate_inventory(function(owner, item) inventory[item:id()] = item end)
    for _, desc in ipairs(transaction.new) do
        if not owned(desc, npc:id()) then
            rollback(npc, transaction)
            return "replacement_lost"
        end
        if not inventory[desc.id] then
            transaction.waits = (transaction.waits or 0) + 1
            if transaction.waits >= 50 then
                rollback(npc, transaction)
                return "attachment_timeout"
            end
            se_save_var(npc:id(), npc:name(), KEY, transaction)
            return "pending"
        end
    end
    -- All new weapons are attached and visible online. Preserve the previous
    -- condition, so migration does not turn damaged NPC equipment into free mint loot.
    for _, desc in ipairs(transaction.new) do inventory[desc.id]:set_condition(desc.condition) end
    -- Drop live inventory references before releasing any old weapon.
    inventory = nil
    for _, desc in ipairs(transaction.old) do
        local weapon = owned(desc, npc:id())
        if weapon then alife_release(weapon) end
    end
    se_save_var(npc:id(), npc:name(), KEY, {name=npc:name(), done=true, rule_revision=RULE_REVISION})
    local created = {}
    for _, desc in ipairs(transaction.new) do created[#created+1] = desc.sec .. ":" .. desc.id end
    printf("[FLX NPC Arsenal] migrated existing NPC %s (%s) | new=%s | removed=%s | combat=%s",
        npc:name(), npc:id(), table.concat(created, ","), #transaction.old, tostring(npc:best_enemy() ~= nil))
    return "done"
end

function process_npc(npc, se_npc)
    if not npc or not se_npc then return "missing" end
    local state = se_load_var(npc:id(), npc:name(), KEY)
    local pending = state and state.name == npc:name() and state.new and state
    local reason = protected_reason(npc, se_npc, pending)
    if reason then
        if pending then rollback(npc, pending) end
        return reason
    end
    if busy(npc, pending) then return "busy" end
    if pending then
        local rank, comm, visual = ranks.get_obj_rank_name(se_npc), npc:character_community(), npc:get_visual_name()
        for _, desc in ipairs(pending.new) do
            if not flx_npc_arsenal.weapon_allowed(desc.sec, comm, rank, visual, desc.slot or firearm_slot(desc.sec)) then
                rollback(npc, pending)
                return "rules_changed_retry"
            end
        end
        return finish_rearm(npc, pending)
    end
    return begin_rearm(npc, se_npc)
end

function actor_on_first_update()
    ready_at = time_global() + option("startup_delay_ms", 3000)
    next_batch, checks = 0, {}
end

function npc_on_death(npc)
    if npc then queue_dead_cleanup(npc) end
end

function npc_on_net_spawn(npc)
    -- Time events are not saved. Recover a pending cleanup if a corpse is
    -- loaded or comes online again after saving between death and cleanup.
    if npc and not npc:alive() then queue_dead_cleanup(npc) end
end

function npc_on_update(npc)
    local now = time_global()
    if now < ready_at or now < next_batch or not npc or not IsStalker(npc) or not npc:alive() then return end
    local id, name = npc:id(), npc:name()
    local check = checks[id]
    if check and check.name == name and now < check.next then return end
    local se_npc = alife_object(id)
    if not se_npc then return end
    local result = process_npc(npc, se_npc)
    local pending = result == "pending"
    checks[id] = {name=name, next=now + (pending and 300 or option("retry_interval_ms", 10000))}
    next_batch = now + option("batch_interval_ms", 200)
end

function on_game_start()
    ini = ini_file("plugins\\flx_npc_arsenal.ltx")
    local enabled = read("migration", "enable")
    if enabled == "false" or enabled == "0" then return end
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("npc_on_update", npc_on_update)
    RegisterScriptCallback("npc_on_death_callback", npc_on_death)
    RegisterScriptCallback("npc_on_net_spawn", npc_on_net_spawn)
end
