; 1 novice, 2 trainee, 3 experienced, 4 professional,
; 5 veteran, 6 expert, 7 master, 8 legend. Armour cannot bypass this gate.
vintorez = 5

[minimum_rank_overrides]
; Optional individual weapon minimum rank, using the same 1..8 scale.
