; FLX NPC Arsenal 1.3.0: rank-only weapon rules.
; Reviewed model rules plus metadata fallback for all live addon weapons.
#include "flx_npc_arsenal_weapons.ltx"

[exclude]
; wpn_example = true

[tier_overrides]
; Optional combat-quality overrides (1 budget, 2 regular, 3 combat, 4 elite).

[origin_overrides]
wpn_brn180 = west
wpn_xm4 = west
wpn_grot = west
wpn_grot_tan = west
wpn_grot_bl = west
wpn_mp155 = east

[family_overrides]
wpn_pm_custom_pm_upgr_kit = pm
wpn_pb_pb_upgr_kit = pb
pri_a17_gauss_rifle = gauss

[spawn_aliases]
; The named Gauss carries a reserved story_id. Its combat equivalent is safe
; for random NPCs; never duplicate the named story object in the simulation.
pri_a17_gauss_rifle = wpn_gauss

[migration]
enable = true
startup_delay_ms = 3000
batch_interval_ms = 200
retry_interval_ms = 10000

[migration_exclude]
; Optional additional exclusions by NPC section name.

[minimum_rank_by_family]
; 1 novice, 2 trainee, 3 experienced, 4 professional,
; 5 veteran, 6 expert, 7 master, 8 legend.
vintorez = 5
val = 5
9a91 = 5
vihr = 5
am17 = 5
amb17 = 7
ash12 = 7
vssk = 7
gauss = 7

[minimum_rank_overrides]
; Optional individual minimum rank. Elite quality always requires master (7).

[audit]
; Audit the complete live system.ltx catalogue, including runtime-only addons.
log_catalogue = true

; Binary audit: these scope models have incompatible/missing OMF resources.
; The creator falls back to the same base gun; no base model is excluded.
[unsafe_variants]
wpn_aug_merc_echo1 = incompatible_or_missing_omf
wpn_protecta_nimble_0kp2 = incompatible_or_missing_omf
wpn_vintorez_n1_usp1 = incompatible_or_missing_omf
wpn_vintorez_nimble_usp1 = incompatible_or_missing_omf
wpn_vintorez_usp1 = incompatible_or_missing_omf
