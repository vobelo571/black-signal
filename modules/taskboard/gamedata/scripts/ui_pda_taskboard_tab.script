-- PDA Taskboard Tab — Lazy Loading + Background Generation
-- Flow: Refresh → scan NPCs → sort by distance
--   immediate: nearest N NPCs → generate task IDs → render categories
--   background: remaining NPCs → batch process → stable merge → final re-render
--   Click category → lazy-prepare descriptions for that category only

local LAYOUT = {
    WINDOW_W                     = 1024,
    WINDOW_H                     = 768,
    CATEGORY_CARD_W              = 200,
    CATEGORY_CARD_H              = 76,
    TASK_CARD_W                  = 564,
    TASK_CARD_H                  = 112,
    DETAILS_SCROLL_THRESHOLD     = 76,
    DESCRIPTION_SCROLL_THRESHOLD = 36,
}

