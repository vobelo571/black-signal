local xml = CScriptXmlInit()
xml:ParseFile("wttg3_slots_centered.xml")

local TEX = "ui\\wttg3_slots\\"
local symbols = {
    "I_Scroll", "I_Urn", "I_Disc", "I_Ankh", "I_Eye",
    "I_Cobra", "I_Falcon", "I_Cat", "I_Anubis"
}
local symbol_fx = {
    I_Cobra = "cobra", I_Falcon = "falcon", I_Cat = "cat", I_Anubis = "anubis"
}
local symbol_pay = {
    I_Scroll = {0.2, 0.5, 2.0},
    I_Urn = {0.4, 0.9, 4.0},
    I_Disc = {0.5, 1.0, 5.0},
    I_Ankh = {0.8, 1.2, 8.0},
    I_Eye = {1.0, 1.5, 10.0},
    I_Cobra = {1.5, 2.0, 12.0},
    I_Falcon = {2.0, 5.0, 15.0},
    I_Cat = {2.5, 10.0, 25.0},
    I_Anubis = {10.0, 25.0, 50.0}
}
local bets = {100, 200, 500, 2500, 5000}
local GRID_COLS = 6
local GRID_ROWS = 5
local GRID_SIZE = GRID_COLS * GRID_ROWS

-- WTTG3 DA_WinType_99-RTP. This table is consulted only after the original
-- 25% win-chance roll succeeds.
local outcomes = {
    {69.7986, 0.25, 3},
    {27.1004, 3, 10},
    {1.8, 10, 25},
    {0.62, 25, 50},
    {0.41, 50, 100},
    {0.2, 100, 250},
    {0.05, 250, 500},
    {0.02, 500, 2500},
    {0.001, 10000, 10000}
}

local instance = nil
local sound_cache = {}

local function play(name)
    if not db.actor then return end
    local snd = sound_cache[name]
    if not snd then
        snd = sound_object("wttg3_slots\\" .. name)
        sound_cache[name] = snd
    end
    snd.volume = 1
    snd:play(db.actor, 0, sound_object.s2d)
end

local function preload_sounds()
    local names = {
        "SFX_SlotIntroMerramun", "SFX_SpinStart", "SFX_SymbolDropRv",
        "SFX_NormalLossResult", "SFX_NormalWinResult", "SFX_MultiplierEffect",
        "SFX_BigMultiplierDropRv",
        "SFX_PayoutCalculation_DeepImpact", "SFX_WinCelebrationPhaseout",
        "SFX_CalloutRv_02", "SFX_CalloutRv_03"
    }
    for i = 1, 9 do names[#names + 1] = string.format("SFX_SymbolMatch_%02d", i) end
    for _, name in ipairs(names) do
        if not sound_cache[name] then sound_cache[name] = sound_object("wttg3_slots\\" .. name) end
    end
end

local function payout_multiplier(symbol, count)
    local pay = symbol_pay[symbol]
    if not pay or count < 8 then return 0 end
    if count >= 12 then return pay[3] end
    if count >= 10 then return pay[2] end
    return pay[1]
end

local function random_symbol()
    return symbols[math.random(1, #symbols)]
end

local function shuffle(t)
    for i = #t, 2, -1 do
        local j = math.random(1, i)
        t[i], t[j] = t[j], t[i]
    end
end

local function schedule(group, id, delay, fn)
    CreateTimeEvent(group, id, delay, function()
        fn()
        return true
    end)
end

local function choose_outcome()
    local roll = math.random() * 100
    local sum = 0
    for level, item in ipairs(outcomes) do
        sum = sum + item[1]
        if roll <= sum then return level, item end
    end
    return 1, outcomes[1]
end

-- The extracted 99-RTP asset determines the chance and payout band, while
-- the original game presents that result as one or more tumbles.  Keep small
-- outcomes entertaining by splitting them across several inexpensive matches
-- instead of turning the first board into an oversized single hit.
local function choose_cascade_count(level)
    local roll = math.random() * 100
    if level == 1 then
        if roll < 35 then return 1 end
        if roll < 80 then return 2 end
        return 3
    elseif level == 2 then
        return roll < 55 and 2 or 3
    elseif level <= 4 then
        return roll < 45 and 2 or (roll < 85 and 3 or 4)
    elseif level <= 6 then
        return 3 + math.random(0, 1)
    elseif level <= 8 then
        return 4 + math.random(0, 1)
    end
    return 5
end

local function choose_initial_winner(level)
    -- Common outcome bands use low-paying symbols, as their extracted target
    -- ranges require.  Expensive symbols remain reserved for rarer bands.
    if level == 1 then return symbols[math.random(2, 5)] end
    if level == 2 then return symbols[math.random(6, 7)] end
    return symbols[math.random(1, #symbols)]
end

-- Calibrated against the extracted 99-RTP outcome probabilities on the full
-- 6x5 grid.  The displayed value belongs to every pyramid on that outcome.
-- Multiple pyramids multiply each other (two x4 pyramids produce x16).
local function pyramid_value_for_level(level)
    if level <= 3 then return 2 end
    if level <= 5 then return 4 end
    if level == 6 then return 10 end
    if level == 7 then return 4 end
    if level == 8 then return 3 end
    return 4
end

local function non_winning_grid()
    local grid, counts = {}, {}
    for i = 1, GRID_SIZE do
        local allowed = {}
        for s = 1, #symbols do
            if (counts[s] or 0) < 7 then allowed[#allowed + 1] = s end
        end
        local s = allowed[math.random(1, #allowed)]
        counts[s] = (counts[s] or 0) + 1
        grid[i] = symbols[s]
    end
    return grid
end

local function winning_grid(winner, count)
    local grid = non_winning_grid()
    local positions = {}
    for i = 1, GRID_SIZE do positions[i] = i end
    shuffle(positions)
    for i = 1, count do grid[positions[i]] = winner end
    -- Re-roll non-winning cells that accidentally extend the chosen group.
    for i = count + 1, GRID_SIZE do
        if grid[positions[i]] == winner then
            repeat grid[positions[i]] = random_symbol() until grid[positions[i]] ~= winner
        end
    end
    local matched = {}
    for i = 1, count do matched[i] = positions[i] end
    return grid, matched
end

local function add_multiplier_symbols(grid, matched, outcome_level)
    if outcome_level <= 1 then return 0 end
    local wanted = 1
    if outcome_level >= 7 then wanted = 2 end
    if outcome_level >= 8 then wanted = 3 end
    if outcome_level >= 9 then wanted = 4 end
    local blocked, candidates = {}, {}
    for _, index in ipairs(matched) do blocked[index] = true end
    for i = 1, GRID_SIZE do if not blocked[i] then candidates[#candidates + 1] = i end end
    shuffle(candidates)
    wanted = math.min(wanted, #candidates)
    for i = 1, wanted do grid[candidates[i]] = "I_MultSymbol_Pyramid" end
    return wanted
end

class "wttg3_merramun_window" (CUIScriptWnd)

function wttg3_merramun_window:__init() super()
    self.bet_index = 1
    self.spinning = false
    self.spin_serial = 0
    self.last_win = 0
    self.grid = non_winning_grid()
    self.round_multiplier = 0
    self.multiplier_count = 0
    self.multiplier_factor = 1
    self.pyramid_value = 2
    self:InitControls()
    self:render_grid(self.grid)
    self:update_text()
    preload_sounds()
end

function wttg3_merramun_window:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self.portrait = xml:InitStatic("portrait", self)
    self.reels_bg = xml:InitStatic("reels_bg", self)
    self.title_deco = xml:InitStatic("title_deco", self)
    self.title_logo = xml:InitStatic("title_logo", self)
    self.balance = xml:InitTextWnd("balance", self)
    self.bet_text = xml:InitTextWnd("bet", self)
    self.win_text = xml:InitTextWnd("win", self)
    self.status = xml:InitTextWnd("status", self)
    self.total_win_text = xml:InitTextWnd("total_win", self)

    self.slots, self.slot_targets, self.match_fx, self.mult_text = {}, {}, {}, {}
    for i = 1, GRID_SIZE do
        self.slots[i] = xml:InitStatic("slot_" .. i, self)
        local pos = self.slots[i]:GetWndPos()
        self.slot_targets[i] = {x = pos.x, y = pos.y}
        self.mult_text[i] = xml:InitTextWnd("mult_" .. i, self)
        self.mult_text[i]:SetText("x2")
        self.mult_text[i]:Show(false)
        self.match_fx[i] = xml:InitStatic("match_" .. i, self)
        self.match_fx[i]:Show(false)
    end
    self.special_fx = xml:InitStatic("special_fx", self)
    self.special_fx:Show(false)

    self.bet_down = xml:Init3tButton("bet_down", self)
    self.spin = xml:Init3tButton("spin", self)
    self.bet_up = xml:Init3tButton("bet_up", self)
    self:Register(self.bet_down, "merramun_bet_down")
    self:Register(self.spin, "merramun_spin")
    self:Register(self.bet_up, "merramun_bet_up")
    self:AddCallback("merramun_bet_down", ui_events.BUTTON_CLICKED, self.on_bet_down, self)
    self:AddCallback("merramun_spin", ui_events.BUTTON_CLICKED, self.on_spin, self)
    self:AddCallback("merramun_bet_up", ui_events.BUTTON_CLICKED, self.on_bet_up, self)
end

function wttg3_merramun_window:render_grid(grid)
    for i = 1, GRID_SIZE do
        self.slots[i]:InitTexture(TEX .. grid[i])
        self.slots[i]:Show(true)
        local target = self.slot_targets[i]
        if target then self.slots[i]:SetWndPos(vector2():set(target.x, target.y)) end
        self.mult_text[i]:SetText("x" .. tostring(self.pyramid_value))
        self.mult_text[i]:SetWndPos(vector2():set(target.x, target.y))
        self.mult_text[i]:Show(grid[i] == "I_MultSymbol_Pyramid")
    end
end

function wttg3_merramun_window:update_text(message)
    local money = db.actor and db.actor:money() or 0
    self.balance:SetText(string.format("BALANCE  %d RU", money))
    self.bet_text:SetText(string.format("BET  %d", bets[self.bet_index]))
    self.win_text:SetText(string.format("WIN  %d", self.last_win))
    local total = math.floor(bets[self.bet_index] * self.round_multiplier * self.multiplier_factor + 0.5)
    self.total_win_text:SetText(string.format("TOTAL  %d", total))
    self.status:SetText(message or "MERRAMUN 99-RTP")
end

function wttg3_merramun_window:on_bet_down()
    if self.spinning then return end
    self.bet_index = math.max(1, self.bet_index - 1)
    play("SFX_ButtonClickRv")
    self:update_text()
end

function wttg3_merramun_window:on_bet_up()
    if self.spinning then return end
    self.bet_index = math.min(#bets, self.bet_index + 1)
    play("SFX_ButtonClickRv")
    self:update_text()
end

-- Original-style reel cascade with the extracted reel offset, acceleration,
-- a softened X-Ray update interval, settle bounce, and evaluation pause.
function wttg3_merramun_window:drop_grid(serial, grid, on_done, start_y, hidden_new)
    self.grid = grid
    self:render_grid(grid)
    for i = 1, GRID_SIZE do
        local target = self.slot_targets[i]
        local col = (i - 1) % GRID_COLS + 1
        local initial_y = start_y and start_y[i] or self.slot_targets[col].y
        self.slots[i]:SetWndPos(vector2():set(target.x, initial_y))
        local hide = hidden_new and hidden_new[i] or (not start_y)
        self.slots[i]:Show(not hide)
        self.mult_text[i]:SetWndPos(vector2():set(target.x, initial_y))
        self.mult_text[i]:Show((not hide) and grid[i] == "I_MultSymbol_Pyramid")
    end

    local tick = 0
    local landed_columns, velocity, bounce, activated = {}, {}, {}, {}
    for i = 1, GRID_SIZE do
        velocity[i] = 0
        bounce[i] = (self.slots[i]:GetWndPos().y >= self.slot_targets[i].y) and 4 or 0
        activated[i] = self.slots[i]:IsShown()
    end
    CreateTimeEvent("wttg3_merramun_drop", "drop_" .. serial .. "_" .. tostring(math.random(1, 999999)), 0.06, function()
        if not instance or serial ~= self.spin_serial then return true end
        tick = tick + 1
        local all_done = true
        for i = 1, GRID_SIZE do
            local col = (i - 1) % GRID_COLS
            local row = math.floor((i - 1) / GRID_COLS)
            -- Bottom symbol enters first, then the reel is filled upward.
            local delay = col + (GRID_ROWS - 1 - row)
            local target = self.slot_targets[i]
            local pos = self.slots[i]:GetWndPos()
            if tick > delay and not activated[i] then
                self.slots[i]:Show(true)
                self.mult_text[i]:Show(self.grid[i] == "I_MultSymbol_Pyramid")
                activated[i] = true
            end
            if tick > delay and bounce[i] == 0 then
                velocity[i] = math.min(30, velocity[i] + 2.2)
                local next_y = pos.y + velocity[i]
                if next_y >= target.y then
                    next_y = target.y + 5
                    bounce[i] = 1
                end
                self.slots[i]:SetWndPos(vector2():set(target.x, next_y))
                self.mult_text[i]:SetWndPos(vector2():set(target.x, next_y))
            elseif bounce[i] == 1 then
                self.slots[i]:SetWndPos(vector2():set(target.x, target.y - 3))
                self.mult_text[i]:SetWndPos(vector2():set(target.x, target.y - 3))
                bounce[i] = 2
            elseif bounce[i] == 2 then
                self.slots[i]:SetWndPos(vector2():set(target.x, target.y + 1))
                self.mult_text[i]:SetWndPos(vector2():set(target.x, target.y + 1))
                bounce[i] = 3
            elseif bounce[i] == 3 then
                self.slots[i]:SetWndPos(vector2():set(target.x, target.y))
                self.mult_text[i]:SetWndPos(vector2():set(target.x, target.y))
                bounce[i] = 4
                if not landed_columns[col] then
                    landed_columns[col] = true
                    play("SFX_SymbolDropRv")
                end
                if self.grid[i] == "I_MultSymbol_Pyramid" then play("SFX_BigMultiplierDropRv") end
            end
            if (not activated[i]) or bounce[i] < 4 then all_done = false end
        end
        if not all_done then return false end
        schedule("wttg3_merramun_phase", "settle_" .. serial, 0.7, on_done)
        return true
    end)
end

function wttg3_merramun_window:show_match(serial, matched, winner, on_done)
    local prefix = symbol_fx[winner] or "match"
    local frame = 0
    local sound_index = 1
    for i, name in ipairs(symbols) do if name == winner then sound_index = i break end end
    play(string.format("SFX_SymbolMatch_%02d", sound_index))

    CreateTimeEvent("wttg3_merramun_match", "match_" .. serial .. "_" .. tostring(math.random(1, 999999)), 0.085, function()
        if not instance or serial ~= self.spin_serial then return true end
        frame = frame + 1
        for _, index in ipairs(matched) do
            self.match_fx[index]:InitTexture(TEX .. "fx\\" .. prefix .. "_" .. string.format("%02d", frame))
            self.match_fx[index]:Show(true)
        end
        if frame < 36 then return false end
        for _, index in ipairs(matched) do
            self.match_fx[index]:Show(false)
            self.slots[index]:Show(false)
        end
        schedule("wttg3_merramun_phase", "vanish_" .. serial, 0.6, on_done)
        return true
    end)
end

function wttg3_merramun_window:animate_pyramid(serial, on_done)
    local frame = 0
    play("SFX_MultiplierEffect")
    CreateTimeEvent("wttg3_merramun_fx", "pyramid_" .. serial, 0.075, function()
        if not instance or serial ~= self.spin_serial then
            self.special_fx:Show(false)
            return true
        end
        frame = frame + 1
        self.special_fx:InitTexture(TEX .. "fx\\pyramid_" .. string.format("%02d", frame))
        self.special_fx:Show(true)
        if frame < 64 then return false end
        self.special_fx:Show(false)
        if on_done then on_done() end
        return true
    end)
end

function wttg3_merramun_window:finish_spin(serial)
    if serial ~= self.spin_serial then return end
    local multiplier = self.round_multiplier * self.multiplier_factor
    local payout = math.floor(bets[self.bet_index] * multiplier + 0.5)
    self.last_win = payout
    local waits_for_multiplier = false
    if payout > 0 then
        db.actor:give_money(payout)
        play("SFX_PayoutCalculation_DeepImpact")
        if self.multiplier_count > 0 then
            waits_for_multiplier = true
            self:animate_pyramid(serial, function()
                if serial == self.spin_serial then self.spinning = false end
            end)
        end
        if multiplier >= 100 then
            play("SFX_CalloutRv_03")
            play("SFX_WinCelebrationPhaseout")
        elseif multiplier >= 25 then
            play("SFX_CalloutRv_02")
        else
            play("SFX_NormalWinResult")
        end
        self:update_text(string.format("TOTAL PAYOUT x%.2f", multiplier))
    else
        play("SFX_NormalLossResult")
        self:update_text("NO WIN")
    end
    if not waits_for_multiplier then self.spinning = false end
end

-- Remove only matched cells. Every unmatched symbol retains its identity and
-- old row, then falls to the lowest free cell in its own column. New symbols
-- are created exclusively in the vacancies above it.
function wttg3_merramun_window:build_collapsed_grid(matched, force_next_win)
    local removed, grid, start_y, new_positions, hidden_new = {}, {}, {}, {}, {}
    for _, index in ipairs(matched) do removed[index] = true end

    for col = 1, GRID_COLS do
        local remaining = {}
        for row = 1, GRID_ROWS do
            local old_index = (row - 1) * GRID_COLS + col
            if not removed[old_index] then
                remaining[#remaining + 1] = {symbol = self.grid[old_index], row = row}
            end
        end
        local vacancies = GRID_ROWS - #remaining
        for row = 1, GRID_ROWS do
            local index = (row - 1) * GRID_COLS + col
            if row <= vacancies then
                new_positions[#new_positions + 1] = index
                hidden_new[index] = true
                start_y[index] = self.slot_targets[col].y
            else
                local old = remaining[row - vacancies]
                grid[index] = old.symbol
                local old_index = (old.row - 1) * GRID_COLS + col
                start_y[index] = self.slot_targets[old_index].y
            end
        end
    end

    local counts = {}
    for i = 1, GRID_SIZE do
        if grid[i] then
            for s, name in ipairs(symbols) do
                if grid[i] == name then counts[s] = (counts[s] or 0) + 1 break end
            end
        end
    end
    shuffle(new_positions)

    local next_winner = nil
    local required = 0
    if force_next_win then
        local lowest = 99
        for s = 1, #symbols do
            local count = counts[s] or 0
            if count < lowest and (8 - count) <= #new_positions then
                lowest = count
                next_winner = s
            end
        end
        -- Normally at least eight vacancies exist because a winning group has
        -- just disappeared. Keep the board safe if another addon ever changes
        -- the grid while the tumble is running.
        if not next_winner then force_next_win = false end
    end
    if force_next_win then
        required = 8 - (counts[next_winner] or 0)
        for n = 1, required do
            grid[new_positions[n]] = symbols[next_winner]
            counts[next_winner] = (counts[next_winner] or 0) + 1
        end
    end

    for n = required + 1, #new_positions do
        local allowed = {}
        for s = 1, #symbols do
            local can_use = (counts[s] or 0) < 7
            if force_next_win and s == next_winner then can_use = false end
            if can_use then allowed[#allowed + 1] = s end
        end
        local s = allowed[math.random(1, #allowed)]
        grid[new_positions[n]] = symbols[s]
        counts[s] = (counts[s] or 0) + 1
    end

    local next_matched = {}
    if force_next_win then
        for i = 1, GRID_SIZE do
            if grid[i] == symbols[next_winner] then next_matched[#next_matched + 1] = i end
        end
    end
    return grid, start_y, next_matched, next_winner and symbols[next_winner] or nil, hidden_new
end

function wttg3_merramun_window:run_cascade(serial, remaining, matched, winner)
    if not winner or not matched or #matched < 8 then
        self:finish_spin(serial)
        return
    end
    local match_multiplier = payout_multiplier(winner, #matched)
    self.round_multiplier = self.round_multiplier + match_multiplier
    self.last_win = math.floor(bets[self.bet_index] * self.round_multiplier + 0.5)
    self:update_text(string.format("%s x%.2f   |   TOTAL x%.2f", string.sub(winner, 3), match_multiplier, self.round_multiplier))
    self:show_match(serial, matched, winner, function()
        local more = remaining - 1
        local grid, start_y, next_matched, next_winner, hidden_new = self:build_collapsed_grid(matched, more > 0)
        self:drop_grid(serial, grid, function()
            if more > 0 then
                self:run_cascade(serial, more, next_matched, next_winner)
            else
                self:finish_spin(serial)
            end
        end, start_y, hidden_new)
    end)
end

function wttg3_merramun_window:on_spin()
    if self.spinning or not db.actor then return end
    local bet = bets[self.bet_index]
    if db.actor:money() < bet then
        play("SFX_NormalLossResult")
        self:update_text("NOT ENOUGH MONEY")
        return
    end

    db.actor:give_money(-bet)
    self.last_win = 0
    self.round_multiplier = 0
    self.multiplier_count = 0
    self.multiplier_factor = 1
    self.pyramid_value = 2
    self.spinning = true
    self.spin_serial = self.spin_serial + 1
    local serial = self.spin_serial
    self:update_text("SPINNING...")

    -- WTTG3 first decides if a spin wins (25%). Outcome level selection and
    -- tumble construction only happen after that decision.
    if math.random() * 100 >= 25 then
        play("SFX_SpinStart")
        schedule("wttg3_merramun_phase", "spin_sync_" .. serial, 0.30, function()
            self:drop_grid(serial, non_winning_grid(), function()
                self:finish_spin(serial)
            end)
        end)
        return
    end

    local level = choose_outcome()
    local cascades = choose_cascade_count(level)
    local winner = choose_initial_winner(level)
    local extra_symbols = level <= 2 and 0 or math.min(7, cascades + 1)
    local match_count = 8
    if extra_symbols > 0 then match_count = math.min(15, 8 + math.random(0, extra_symbols)) end
    local grid, matched = winning_grid(winner, match_count)
    self.pyramid_value = pyramid_value_for_level(level)
    self.multiplier_count = add_multiplier_symbols(grid, matched, level)
    if self.multiplier_count > 0 then
        self.multiplier_factor = math.pow(self.pyramid_value, self.multiplier_count)
    end
    play("SFX_SpinStart")
    schedule("wttg3_merramun_phase", "spin_sync_" .. serial, 0.30, function()
        self:drop_grid(serial, grid, function()
            self:run_cascade(serial, cascades, matched, winner)
        end)
    end)
end

function wttg3_merramun_window:OnKeyboard(dik, keyboard_action)
    local result = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
        self:Close()
        return true
    end
    return result
end

function wttg3_merramun_window:Close()
    -- Do not cancel a paid round halfway through its tumble chain.
    if self.spinning then
        self:update_text("WAIT FOR THE SPIN TO FINISH")
        return
    end
    if self:IsShown() then self:HideDialog() end
    Unregister_UI("UIWTTG3Merramun")
end

function get_ui()
    if not instance then instance = wttg3_merramun_window() end
    return instance
end

function open_ui()
    local gui = get_ui()
    if not gui:IsShown() then
        gui:update_text()
        gui:ShowDialog(true)
        Register_UI("UIWTTG3Merramun", "ui_wttg3_merramun")
        play("SFX_SlotIntroMerramun")
    end
end

function reset_ui()
    if instance and instance.spinning then return end
    if instance and instance:IsShown() then instance:Close() end
    instance = nil
end
