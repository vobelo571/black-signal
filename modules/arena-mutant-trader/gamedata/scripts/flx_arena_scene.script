-- Self-contained binding: old saves can call this module before any helper is loaded.
function stabilize(obj)
    local shell=obj:get_physics_shell()
    if not shell then return false end
    shell:block_breaking()
    shell:freeze() -- native Fix() for every element + cbNCStatic; never moves the object
    return true
end

function bind_static(obj)
    obj:bind_object(flx_arena_scene_physics_binder(obj))
end

class "flx_arena_scene_physics_binder" (object_binder)
function flx_arena_scene_physics_binder:__init(obj) super(obj)
    self.settled=false
end

function flx_arena_scene_physics_binder:net_spawn(data)
    if not object_binder.net_spawn(self,data) then return false end
    self.settled=stabilize(self.object)
    return true
end

function flx_arena_scene_physics_binder:update(delta)
    object_binder.update(self,delta)
    if not self.settled then self.settled=stabilize(self.object) end
end
