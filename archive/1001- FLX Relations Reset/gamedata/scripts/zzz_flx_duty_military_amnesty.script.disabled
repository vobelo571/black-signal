-- Executes the one-shot request written by GAMMA Save Editor.
-- Repairs personal hostility for allied and neutral factions only.

local trigger = "flx_reset_non_enemy_relations_request"
local handled_communities = {}

local function is_non_enemy(community, actor_community)
	if not community or community == "monster" or community == "zombied" then
		return false
	end
	local ok, enemies = pcall(game_relations.is_factions_enemies, community, actor_community)
	return ok and not enemies
end

local function reset_faction(community)
	if handled_communities[community] then return end
	handled_communities[community] = true
	pcall(relation_registry.set_community_goodwill, community, AC_ID, 0)
	pcall(db.actor.set_community_goodwill, db.actor, community, 0)
end

local function reset_personal_goodwill(se_obj, actor_community)
	if not (se_obj and se_obj.community and se_obj.force_set_goodwill) then return end
	local ok, community = pcall(se_obj.community, se_obj)
	if ok and is_non_enemy(community, actor_community) then
		reset_faction(community)
		pcall(se_obj.force_set_goodwill, se_obj, 0, AC_ID)
	end
end

local function apply_amnesty()
	if not db.actor or load_var(db.actor, trigger, false) ~= true then return end
	local actor_community = character_community(db.actor)
	if not actor_community then return end

	handled_communities = {}
	local sim = alife()
	if not sim then return end

	sim:iterate_objects(function(se_obj)
		reset_personal_goodwill(se_obj, actor_community)
	end)

	save_var(db.actor, trigger, false)
	printf("[FLX Amnesty] Allied and neutral relations reset")
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", apply_amnesty)
	RegisterScriptCallback("actor_on_update", apply_amnesty)
end
